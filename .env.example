# Gemini API Key (Required)
GEMINI_API_KEY="your-gemini-api-key-here"

# Model selection (Optional, defaults to gemini-flash-lite-latest with auto-failover)
GEMINI_MODEL="gemini-flash-lite-latest"

# Server Configuration (Optional, automatically set by PaaS/Cloud providers)
PORT=8000
HOST="0.0.0.0"

# Database Configuration (Optional, defaults to inventory.db)
DATABASE_PATH="inventory.db"

